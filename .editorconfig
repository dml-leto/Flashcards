# https://editorconfig.org - shared formatting rules for any editor/IDE
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,mjs,vue,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.md]
# Two trailing spaces in Markdown are a line break, do not strip them
trim_trailing_whitespace = false
